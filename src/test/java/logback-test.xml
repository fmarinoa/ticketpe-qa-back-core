<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- el wire/headers de Apache vuelca cada byte del request y la respuesta -->
  <logger name="org.apache.http" level="WARN"/>
  <!-- Karate loguea request/response en DEBUG: es el log util, se queda -->
  <logger name="karate" level="DEBUG"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
